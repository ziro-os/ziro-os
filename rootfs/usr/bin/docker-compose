#!/bin/sh
# Compatibility wrapper for docker-compose. With the `docker` module (Docker Engine) it is the Compose plugin of
# the real docker CLI; otherwise ziroctl compose (nerdctl compose).
REAL=/var/lib/ziro/plugins/docker/bin/docker
if [ -x "$REAL" ]; then
    exec "$REAL" compose "$@"
fi
if [ -x /usr/bin/ziroctl ]; then
    exec /usr/bin/ziroctl compose "$@"
elif [ -x /bin/ziroctl ]; then
    exec /bin/ziroctl compose "$@"
else
    echo "ziroctl not found"
    exit 1
fi
