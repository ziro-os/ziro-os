#!/bin/sh
# Ziro-OS BusyBox udhcpc auto-configuration script
# Handles DHCP IP assignment, routing, and DNS configuration.

RESOLV_CONF="/etc/resolv.conf"

case "$1" in
    deconfig)
        echo "[udhcpc] deconfiguring $interface..."
        if command -v ip >/dev/null 2>&1; then
            ip -4 addr flush dev "$interface" 2>/dev/null || true
        else
            ifconfig "$interface" 0.0.0.0 2>/dev/null || true
        fi
        ;;

    renew|bound)
        echo "[udhcpc] configuring $interface with IP $ip/$mask..."
        
        # 1. Assign IP address
        if command -v ip >/dev/null 2>&1; then
            ip -4 addr add "$ip/$mask" dev "$interface" ${broadcast:+broadcast $broadcast} 2>/dev/null || true
            ip link set dev "$interface" up 2>/dev/null || true
        else
            ifconfig "$interface" "$ip" netmask "$mask" ${broadcast:+broadcast $broadcast} up 2>/dev/null || true
        fi

        # 2. Add default gateway route
        if [ -n "$router" ]; then
            echo "[udhcpc] setting default route via $router on $interface..."
            if command -v ip >/dev/null 2>&1; then
                while ip -4 route del default dev "$interface" 2>/dev/null; do :; done
                ip -4 route add default via "$router" dev "$interface" 2>/dev/null || true
            else
                route del default dev "$interface" 2>/dev/null || true
                route add default gw "$router" dev "$interface" 2>/dev/null || true
            fi
        fi

        # 3. Update DNS resolvers
        if [ -n "$dns" ]; then
            echo "[udhcpc] updating $RESOLV_CONF with DNS: $dns..."
            echo "# Generated by udhcpc for $interface" > "$RESOLV_CONF.tmp"
            [ -n "$domain" ] && echo "search $domain" >> "$RESOLV_CONF.tmp"
            for server in $dns; do
                echo "nameserver $server" >> "$RESOLV_CONF.tmp"
            done
            # Fallback public DNS
            echo "nameserver 1.1.1.1" >> "$RESOLV_CONF.tmp"
            mv "$RESOLV_CONF.tmp" "$RESOLV_CONF"
        fi
        echo "[udhcpc] network configuration complete for $interface (IP: $ip)"
        ;;

    leasefail)
        echo "[udhcpc] warning: failed to obtain DHCP lease on $interface"
        ;;

    nak)
        echo "[udhcpc] warning: received NAK on $interface"
        ;;
esac

exit 0
