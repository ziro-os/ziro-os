export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/opt/cni/bin
export HOME=/root
export TERM="${TERM:-linux}" # keep the ssh client's terminal type (colors, glyphs)
export PS1='\u@\h:\w\$ '

# Display dynamic cloud status banner once per login session
if [ -z "$ZIRO_BANNER_SHOWN" ]; then
    export ZIRO_BANNER_SHOWN=1
    if [ -x /usr/bin/ziro-motd ]; then
        /usr/bin/ziro-motd
    elif [ -x /usr/bin/ziroctl ]; then
        /usr/bin/ziroctl motd
    elif [ -f /etc/motd ]; then
        cat /etc/motd
    fi
fi
