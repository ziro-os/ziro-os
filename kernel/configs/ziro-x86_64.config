# Ziro-OS custom kernel — x86_64 fragment (merged after ziro-common.config)

# Paravirtualized guest support: KVM, Xen PVHVM/PVH (AWS Xen, Firecracker PVH), Hyper-V, VMware
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
# KVM host support (modules): nested VMs, `ziroctl dev run` on a Ziro host, Firecracker/Kata.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
# Indirect branch tracking (Intel CET): forward-edge control-flow integrity on capable CPUs.
CONFIG_X86_KERNEL_IBT=y
CONFIG_XEN_PVHVM=y
CONFIG_XEN_PVH=y
CONFIG_PTP_1588_CLOCK_KVM=y
CONFIG_NR_CPUS=512

# VMware ESXi / Workstation / Fusion
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMXNET3=y
CONFIG_VMWARE_BALLOON=m
CONFIG_VMWARE_VMCI=m
CONFIG_VMWARE_VMCI_VSOCKETS=m
CONFIG_DRM_VMWGFX=m

# Legacy PC storage/console (QEMU i440fx, VirtualBox, older bare metal)
CONFIG_ATA_PIIX=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_DRM_BOCHS=m

# Faster kernel decompression at boot
CONFIG_KERNEL_ZSTD=y

# CPU mitigations & hardening
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_LEGACY_VSYSCALL_NONE=y
# No ioperm/iopl (raw port I/O) for user space. (MODIFY_LDT_SYSCALL stays: Xen PV support selects it.)
# CONFIG_X86_IOPL_IOPERM is not set
