# Ziro-OS custom kernel — common fragment (all architectures)
#
# Merged on top of the architecture's upstream defconfig (broad hardware support),
# then verified by kernel/build-kernel.sh: every option below must survive
# olddefconfig or the build fails. Boot-critical cloud/hypervisor storage & NIC
# drivers are built in (=y) so every platform boots without module loading.

CONFIG_LOCALVERSION="-ziro"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Modules must be signed; unsigned or modified modules are rejected. Release kernels sign with
# the persistent Ziro module key (CI secret ZIRO_MODULE_SIGNING_KEY; public half in
# kernel/certs/ziro-modules.crt), so modules built later by Ziro CI (kernel kit) still load.
# Local builds without the secret sign with an ephemeral per-build key.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
# zstd-compressed modules: ~3x smaller initramfs/rootfs, decompressed by kmod (or in-kernel).
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# ---- Boot ----
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ---- Container isolation ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_PSI=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_MISC=y
# CRIU / container checkpoint-restore (podman/containerd checkpoint)
CONFIG_CHECKPOINT_RESTORE=y

# ---- Filesystems ----
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=m
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=m
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
# NFS server (the opt-in `nfs` module / cluster storage)
CONFIG_NFSD=m
CONFIG_NFSD_V4=y
CONFIG_EFIVAR_FS=m
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=m
CONFIG_DM_CRYPT=m
CONFIG_DM_THIN_PROVISIONING=m

# ---- Storage: generic ----
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=m
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MEGARAID_SAS=m
CONFIG_SCSI_MPT3SAS=m
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=m

# ---- KVM / QEMU / Firecracker / Proxmox / GCP / Oracle (virtio) ----
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_FS=m
CONFIG_HW_RANDOM=y
# TPM 2.0 (bare metal and cloud vTPMs: GCP/Azure/AWS NitroTPM): seals the cluster data key
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m

# ---- Microsoft Hyper-V / Azure ----
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_CONNECTOR=y
CONFIG_HYPERV_UTILS=m
CONFIG_HYPERV_BALLOON=m
CONFIG_HYPERV_KEYBOARD=m
CONFIG_HYPERV_VSOCKETS=m
CONFIG_PCI_HYPERV=m
CONFIG_DRM_HYPERV=m
CONFIG_NET_VENDOR_MICROSOFT=y
CONFIG_MICROSOFT_MANA=m
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y

# ---- Xen (older AWS instance types, Xen/XCP-ng hosts) ----
CONFIG_XEN=y
CONFIG_XEN_BLKDEV_FRONTEND=y
CONFIG_XEN_NETDEV_FRONTEND=y
CONFIG_HVC_XEN=y

# ---- AWS Nitro (ENA + NVMe EBS) / Google Cloud (gVNIC) ----
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=y
CONFIG_NET_VENDOR_GOOGLE=y
CONFIG_GVE=y

# ---- Physical NICs (bare metal) ----
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_IXGBEVF=m
CONFIG_I40E=m
CONFIG_I40EVF=m
CONFIG_ICE=m
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_BNXT=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_RTL8152=m

# ---- Container networking ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_WIREGUARD=y
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_IPVLAN=m
CONFIG_MACVLAN=m
CONFIG_DUMMY=m
CONFIG_BONDING=m
CONFIG_VLAN_8021Q=m
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_CGROUP=m
CONFIG_NET_CLS_BPF=m
# IPsec overlays (Calico/Cilium/strongSwan)
CONFIG_XFRM_USER=m
CONFIG_INET_ESP=m
CONFIG_INET6_ESP=m
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y

# ---- Netfilter: nftables (ziroctl firewall) + iptables (CNI, nerdctl, kube-proxy) ----
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NF_TABLES_BRIDGE=m
# conntrack(8), kube-proxy UDP flush, Cilium/Calico conntrack GC
CONFIG_NF_CT_NETLINK=m
# Legacy xtables stay available: CNI plugins / nerdctl / kube-proxy may use iptables-legacy or iptables-nft
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
# Calico / kube-router: bridge physdev matches and raw-table NOTRACK
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_RAW=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_SET=m
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_SH=m
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y

# ---- Kernel self-protection ----
CONFIG_RANDOMIZE_BASE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# Integrity lockdown: closes the ways around MODULE_SIG_FORCE (unsigned kexec, hibernation
# images, /dev/mem, /dev/port, ioperm, MSR writes, ACPI table overrides, debugfs).
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
# Landlock: unprivileged sandboxing for workloads; BPF LSM for Tetragon/KubeArmor policies.
CONFIG_SECURITY_LANDLOCK=y
CONFIG_BPF_LSM=y
# kprobe/uprobe events: required by BPF_LSM (via BPF_EVENTS) and by eBPF observability tools.
# arm64 defconfig turns FTRACE off; kprobes stay usable under lockdown=integrity.
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_LSM="lockdown,yama,landlock,ima,bpf"
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_SECURITY_DMESG_RESTRICT=y
# No cache merging: keeps cross-cache heap exploitation harder
# CONFIG_SLAB_MERGE_DEFAULT is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_LDISC_AUTOLOAD is not set
# debugfs may be pulled in by other options; never expose it
CONFIG_DEBUG_FS_ALLOW_NONE=y
# BTF for CO-RE eBPF (Cilium, Falco, Tetragon, bpftrace). Needs full DWARF at build time;
# modules are still stripped (the .BTF section survives --strip-debug).
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# CONFIG_PROC_KCORE is not set
# CONFIG_COMPAT_BRK is not set
# Zero freed memory (stale secrets can't leak through new allocations); opt out per host with
# the init_on_free=0 boot parameter if a workload is allocation-bound.
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_SCHED_STACK_END_CHECK=y
# KFENCE: sampling heap-error detector, near-zero overhead in production
CONFIG_KFENCE=y
# Attack surface a container host doesn't need: kexec (lockdown already refuses unsigned
# images), hibernation, SysRq, /dev/port.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_DEVPORT is not set
# (USERFAULTFD stays for CRIU lazy migration; vm.unprivileged_userfaultfd=0 limits it to root.
#  BINFMT_MISC stays as a module: multi-arch image builds need qemu-user binfmt.
#  UBSAN_BOUNDS and arm64 SHADOW_CALL_STACK are left for a clang build.)

# ---- Integrity (IMA) and the security packs ----
# IMA measures executables and modules into the audit log / TPM PCR 10; the `integrity` module
# loads the policy and compares against the shipped baseline. EVM (xattr HMACs) is not used.
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_AUDIT=y
CONFIG_IMA=y
CONFIG_IMA_MEASURE_PCR_IDX=10
CONFIG_CRYPTO_SHA256=y
CONFIG_IMA_DEFAULT_HASH_SHA256=y
CONFIG_IMA_READ_POLICY=y
CONFIG_IMA_WRITE_POLICY=y
# CONFIG_EVM is not set
# fs-verity: per-file Merkle-tree integrity (groundwork for the immutable root)
CONFIG_FS_VERITY=y
# fanotify permission events: ClamAV on-access scanning (clamav module, onaccess setting)
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y

# ---- Network performance ----
# BBR congestion control with the fq qdisc (pacing): higher throughput, lower latency on lossy
# and long-distance links; the defaults for every socket.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# Multipath TCP, kernel TLS (sendfile through TLS), nftables flowtables (fast path for
# established forwarded flows: containers, gateway)
CONFIG_MPTCP=y
CONFIG_MPTCP_IPV6=y
CONFIG_TLS=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NFT_FLOW_OFFLOAD=m

# ---- Memory ----
# Transparent huge pages only where applications ask (madvise): no latency spikes from
# khugepaged on databases; zswap available (off unless enabled) for hosts with swap.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_ZSWAP=y
CONFIG_CRYPTO_ZSTD=y

# SYN-flood defence (net.ipv4.tcp_syncookies). The arm64 defconfig leaves it off; found by
# `ziroctl security audit` (CIS 3.3.8) on the custom kernel.
CONFIG_SYN_COOKIES=y

# Linux audit (the opt-in `auditd` module: ziroctl module enable auditd)
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
