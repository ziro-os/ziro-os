# Ziro-OS custom kernel — arm64 fragment (merged after ziro-common.config)
# arm64 defconfig already covers servers (ACPI/SBSA), SoC boards and Graviton/Ampere/Neoverse.

CONFIG_ACPI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_PTP_1588_CLOCK_KVM=y

# Hardening
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_BTI=y
# (ARM64_BTI_KERNEL needs clang on 6.18: it depends on !CC_IS_GCC)

# Self-decompressing EFI image (vmlinuz.efi): boots from UEFI firmware, GRUB and QEMU -kernel
CONFIG_EFI_ZBOOT=y
CONFIG_KERNEL_ZSTD=y

# Container host, not a desktop: drop audio, Wi-Fi, Bluetooth, V4L/DVB and discrete GPUs
# (defconfig builds them for SoC boards). All SoC/server platforms and virtio-gpu stay.
# CONFIG_SOUND is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_MSM is not set
