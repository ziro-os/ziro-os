# Ziro-OS custom kernel — arm64 fragment (merged after ziro-common.config)
# arm64 defconfig already covers servers (ACPI/SBSA), SoC boards and Graviton/Ampere/Neoverse.

CONFIG_ACPI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_PTP_1588_CLOCK_KVM=y

# Hardening
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_BTI=y

# Self-decompressing EFI image (vmlinuz.efi): boots from UEFI firmware, GRUB and QEMU -kernel
CONFIG_EFI_ZBOOT=y
CONFIG_KERNEL_GZIP=y
