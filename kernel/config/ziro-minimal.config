# Ziro-OS Minimal Kernel Configuration
# Based on Linux kernel with container-focused features

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y

# Essential for containers
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y

# Security
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_CAPABILITIES=y

# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE=y
CONFIG_VETH=y

# Storage
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y

# Virtualization support
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

# Minimal drivers only
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y