# Snyk (https://snyk.io) policy file for this Go module.
version: v1.25.0
ignore:
  # CVE-2026-96812 (gVisor runsc / sentry gofer). wireguard-go's go.mod requires gVisor (for its
  # optional netstack TUN), so the module graph lists it, but no gVisor package is compiled into
  # this binary on any OS (go list -deps). go.mod already pins a gVisor commit after the fix
  # (20260824.0); Snyk's advisory range "<20260824.0" is compared against Go pseudo-versions
  # (v0.0.0-<date>-<hash>), so every gVisor version still matches. Re-check on expiry.
  SNYK-GOLANG-GVISORDEVGVISORRUNSC-20158553:
    - '*':
        reason: >-
          Not linked (0 gVisor packages in go list -deps); module graph already at a post-fix
          gVisor commit, which Snyk cannot match against the date-style fixed version.
        expires: 2027-01-02T00:00:00.000Z
        created: 2026-10-04T00:00:00.000Z
  SNYK-GOLANG-GVISORDEVGVISORPKGSENTRYFSIMPLGOFER-20158554:
    - '*':
        reason: >-
          Not linked (0 gVisor packages in go list -deps); module graph already at a post-fix
          gVisor commit, which Snyk cannot match against the date-style fixed version.
        expires: 2027-01-02T00:00:00.000Z
        created: 2026-10-04T00:00:00.000Z
