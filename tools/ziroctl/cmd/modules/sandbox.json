{
  "name": "sandbox",
  "version": "1.0",
  "description": "Isolated sandboxes for untrusted code and AI agents: gVisor (runsc) and ziro-sandboxd, the daemon behind `ziroctl sandbox` and /api/v1/sandboxes",
  "min_memory_mb": 1024,
  "artifacts": [
    {
      "url": "https://github.com/google/gvisor/releases/download/release-20260928.0/gvisor-x86_64.tar.bz2",
      "sha256": "f3ed9131bc252259df150e270154180188f9df56b73a2312940325e1f522a2d6",
      "extract": "runsc",
      "path": "/var/lib/ziro/plugins/sandbox/runsc",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/google/gvisor/releases/download/release-20260928.0/gvisor-x86_64.tar.bz2",
      "sha256": "f3ed9131bc252259df150e270154180188f9df56b73a2312940325e1f522a2d6",
      "extract": "gvisor-bin/gvisor_sentry",
      "path": "/var/lib/ziro/plugins/sandbox/gvisor-bin/gvisor_sentry",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/google/gvisor/releases/download/release-20260928.0/gvisor-aarch64.tar.bz2",
      "sha256": "b7e11d27cbd69370ed7addb6c0d1c33e70e57a153cee57b5fdc5344bf303c7eb",
      "extract": "runsc",
      "path": "/var/lib/ziro/plugins/sandbox/runsc",
      "mode": "0755",
      "arch": "aarch64"
    },
    {
      "url": "https://github.com/google/gvisor/releases/download/release-20260928.0/gvisor-aarch64.tar.bz2",
      "sha256": "b7e11d27cbd69370ed7addb6c0d1c33e70e57a153cee57b5fdc5344bf303c7eb",
      "extract": "gvisor-bin/gvisor_sentry",
      "path": "/var/lib/ziro/plugins/sandbox/gvisor-bin/gvisor_sentry",
      "mode": "0755",
      "arch": "aarch64"
    }
  ],
  "dirs": [
    {
      "path": "/var/lib/ziro/sandbox",
      "mode": "0700"
    }
  ],
  "files": [
    {
      "path": "/var/lib/ziro/plugins/sandbox/runsc-ziro",
      "mode": "0755",
      "content": "#!/bin/sh\n# Managed by `ziroctl module enable sandbox`: the OCI runtime sandboxes run under\n# (nerdctl --runtime). systrap needs no KVM, so it works in cloud VMs and on arm64;\n# overlay2=none keeps the rootfs on the host snapshot (gofer-mediated), so a sandbox can be committed.\nexec /var/lib/ziro/plugins/sandbox/runsc --platform=systrap --overlay2=none \"$@\"\n"
    }
  ],
  "prepare": [
    {
      "exec": "/bin/ln",
      "args": [
        "-sfn",
        "/usr/bin/ziroctl",
        "/usr/bin/ziro-sandboxd"
      ],
      "creates": "/usr/bin/ziro-sandboxd"
    }
  ],
  "services": [
    {
      "name": "ziro-sandboxd",
      "description": "Ziro sandbox daemon: runs and reaps gVisor sandboxes (local socket only)",
      "exec": "/usr/bin/ziro-sandboxd",
      "args": "",
      "pidfile": "/run/ziro-sandboxd.pid",
      "logfile": "/var/log/ziro-sandboxd.log",
      "resources": {
        "memory": "1Gi",
        "pids": 4096
      }
    }
  ],
  "health": {
    "exec": "/var/lib/ziro/plugins/sandbox/runsc",
    "args": [
      "--version"
    ],
    "timeout": "30s",
    "expect": "runsc version"
  }
}
